[Unit]
Description=Cutshort OpenClaw Conversation Monitor Service
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/automation
EnvironmentFile=/home/ubuntu/automation/.env
ExecStart=/usr/bin/node /home/ubuntu/automation/scripts/run-cutshort-conversation-monitor.js
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
